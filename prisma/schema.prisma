datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY & INFRASTRUCTURE
// ==========================================

model Institution {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  
  users          User[]
  departments    Department[]
  feeStructures  FeeStructure[]
  settings       Settings[]
}

model User {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  email          String      @unique
  passwordHash   String
  role           Role        @default(STUDENT) // Simplified Role model (Real RBAC handled via Permissions arrays in code)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  auditLogs      AuditLog[]

  @@index([institutionId, role])
}

enum Role {
  SUPERADMIN
  ADMIN
  PRINCIPAL
  HOD
  FACULTY
  STUDENT
  STAFF
}

model StudentProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  institutionId  String
  
  firstName      String
  lastName       String
  enrollmentNo   String  @unique
  batchId        String?
  batch          Batch?  @relation(fields: [batchId], references: [id])

  attendanceRecords  AttendanceRecord[]
  invoices           Invoice[]
  bedAllocations     BedAllocation[]
  hostelHistories    HostelHistoryLog[]
  transportPasses    StudentTransportPass[]
  answerScripts      AnswerScript[]

  @@index([institutionId, batchId])
}

model FacultyProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  institutionId  String
  
  firstName      String
  lastName       String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  teachingAllocations    TeachingAllocation[]
  scriptAllocations      ScriptAllocation[]
  evaluationRecords      EvaluationRecord[]
  moderationRecords      ModerationRecord[]
}

model Settings {
  id            String  @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  key           String  // e.g. 'LIB_LATE_FINE_PER_DAY'
  value         String
  
  @@unique([institutionId, key])
}

model AuditLog {
  id            String   @id @default(uuid())
  institutionId String
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  resourceTable String
  resourceId    String
  oldValues     Json?
  newValues     Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([institutionId, resourceTable, resourceId])
}

model JobArchive {
  id          String   @id @default(uuid())
  jobName     String
  payload     Json
  status      JobStatus @default(PENDING)
  errorLog    String?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status, jobName])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


// ==========================================
// 2. ACADEMICS
// ==========================================

model Department {
  id             String   @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  name           String

  faculties      FacultyProfile[]
  courses        Course[]
}

model Course {
  id             String   @id @default(uuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  name           String
  
  batches        Batch[]
  subjects       Subject[]
}

model Batch {
  id             String   @id @default(uuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  year           Int

  students       StudentProfile[]
  timeSlots      TimeSlot[]
}

model Subject {
  id             String   @id @default(uuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  name           String
  code           String   @unique

  teachingAllocations TeachingAllocation[]
  examSchedules       ExamSchedule[]
}

model TeachingAllocation {
  id             String   @id @default(uuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id])
  facultyId      String
  faculty        FacultyProfile @relation(fields: [facultyId], references: [id])

  timeSlots      TimeSlot[]

  @@unique([subjectId, facultyId])
}

model TimeSlot {
  id                  String   @id @default(uuid())
  batchId             String
  batch               Batch    @relation(fields: [batchId], references: [id])
  teachingAllocationId String
  teachingAllocation  TeachingAllocation @relation(fields: [teachingAllocationId], references: [id])
  
  dayOfWeek           Int      // 0-6
  startTime           String   // '09:00'
  endTime             String   // '10:00'

  attendanceSessions  AttendanceSession[]

  @@index([dayOfWeek, startTime, endTime])
  @@index([batchId, dayOfWeek])
}


// ==========================================
// 3. ATTENDANCE
// ==========================================

model AttendanceSession {
  id             String   @id @default(uuid())
  timeSlotId     String
  timeSlot       TimeSlot @relation(fields: [timeSlotId], references: [id])
  sessionDate    DateTime // The actual date of class
  status         AttStatus @default(ACTIVE)

  records        AttendanceRecord[]

  @@unique([timeSlotId, sessionDate]) // Prevent dual marking
}

enum AttStatus {
  ACTIVE
  LOCKED
}

model AttendanceRecord {
  id             String   @id @default(uuid())
  sessionId      String
  session        AttendanceSession @relation(fields: [sessionId], references: [id])
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id])
  isPresent      Boolean

  @@unique([sessionId, studentId]) // Idempotency
}


// ==========================================
// 4. EXAMS
// ==========================================

model ExamSchedule {
  id             String   @id @default(uuid())
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id])
  examDate       DateTime
  maxMarks       Float
  workflowStatus WorkflowStatus @default(DRAFT)
  
  marksInternal       MarksInternal[]
  answerScripts       AnswerScript[]
  resultPublications  ResultPublication[]
}

enum WorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

model MarksInternal {
  id             String   @id @default(uuid())
  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  studentId      String
  marksObtained  Float
  gradeCalculated String?
  isLocked       Boolean  @default(false)
  version        Int      @default(1)

  @@unique([examScheduleId, studentId])
}

model GradingScale {
  id             String   @id @default(uuid())
  minMarks       Float
  maxMarks       Float
  grade          String
}


// ==========================================
// 5. FINANCE
// ==========================================

model FeeStructure {
  id             String      @id @default(uuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  name           String
  amount         Float

  invoiceItems   InvoiceLineItem[]
}

model Invoice {
  id             String   @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  totalAmount    Float
  status         InvoiceStatus @default(DUE)
  idempotencyKey String   @unique // Prevent double generations
  dueDate        DateTime

  lineItems      InvoiceLineItem[]
  payments       Payment[]

  @@index([studentId, status])
  @@index([dueDate, status])
}

enum InvoiceStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
}

model InvoiceLineItem {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  amount         Float
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amountPaid     Float
  method         String   // RAZORPAY / CASH
  transactionRef String   @unique // Gateway references natively
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime @default(now())

  refunds        Refund[]

  @@index([invoiceId, status])
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
}

model Refund {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id])
  amount         Float
  reason         String
  status         RefundStatus @default(INITIATED)
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}


// ==========================================
// 6. OPERATIONS
// ==========================================

model HostelRoom {
  id             String   @id @default(uuid())
  roomNo         String
  capacity       Int
  
  bedAllocations BedAllocation[]
}

model BedAllocation {
  id             String   @id @default(uuid())
  roomId         String
  room           HostelRoom @relation(fields: [roomId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  allocatedFrom  DateTime
  allocatedTo    DateTime?
  status         String   @default("ACTIVE")
}

model HostelHistoryLog {
  id             String   @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  roomId         String
  action         String   // CHECK_IN / CHECK_OUT
  date           DateTime
}

model Vehicle {
  id             String   @id @default(uuid())
  registrationNo String
  capacity       Int

  driverAllocations DriverAllocation[]
}

model Route {
  id             String   @id @default(uuid())
  name           String

  routeStops     RouteStop[]
  driverAllocations DriverAllocation[]
}

model DriverAllocation {
  id             String   @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  routeId        String
  route          Route    @relation(fields: [routeId], references: [id])
}

model RouteStop {
  id             String   @id @default(uuid())
  routeId        String
  route          Route    @relation(fields: [routeId], references: [id])
  name           String

  passes         StudentTransportPass[]
}

model StudentTransportPass {
  id             String   @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  routeStopId    String
  routeStop      RouteStop @relation(fields: [routeStopId], references: [id])
}

model LibraryCopy {
  id             String   @id @default(uuid())
  bookId         String   // Maps to generic Book Metadata title/isbn
  status         String   @default("AVAILABLE") // AVAILABLE, ISSUED, LOST

  transactions   LibraryTransaction[]
}

model LibraryTransaction {
  id             String   @id @default(uuid())
  copyId         String
  copy           LibraryCopy @relation(fields: [copyId], references: [id])
  userId         String   // Student or Faculty UUID
  issueDate      DateTime
  dueDate        DateTime
  returnDate     DateTime?
  fineAmount     Float    @default(0)
}

model InventoryAsset {
  id             String   @id @default(uuid())
  name           String
  status         String   @default("AVAILABLE") // AVAILABLE, DEPLOYED, MAINTENANCE, DAMAGED

  allocations    InventoryAllocation[]
}

model InventoryAllocation {
  id             String   @id @default(uuid())
  assetId        String
  asset          InventoryAsset @relation(fields: [assetId], references: [id])
  allocatedTo    String   // UserId
  dateIssued     DateTime
  dateReturned   DateTime?
}


// ==========================================
// 7. ANALYTICS (Pre-Aggregated Mirrors)
// ==========================================

model ReportsDailyAttendanceAgg {
  id             String   @id @default(uuid())
  institutionId  String
  departmentId   String?  // Null means Global bounds
  date           DateTime
  present        Int
  absent         Int
  
  @@unique([institutionId, departmentId, date])
}

model ReportsMonthlyFinanceAgg {
  id             String   @id @default(uuid())
  institutionId  String
  year           Int
  month          Int
  totalCollected Float
  due            Float

  @@unique([institutionId, year, month])
}


// ==========================================
// 8. AUTONOMOUS EXAM CELL
// ==========================================

model AnswerScript {
  id             String   @id @default(uuid())
  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id])
  maskedId       String   @unique // For anonymous evaluation
  status         ScriptStatus @default(PENDING)
  finalMarks     Float?

  allocations    ScriptAllocation[]
  evaluations    EvaluationRecord[]
  moderations    ModerationRecord[]
  revaluations   RevaluationRequest[]

  @@unique([examScheduleId, studentId])
}

enum ScriptStatus {
  PENDING
  ALLOCATED
  EVALUATED
  REVIEWED
  FINALIZED
}

model ScriptAllocation {
  id             String   @id @default(uuid())
  scriptId       String
  script         AnswerScript @relation(fields: [scriptId], references: [id])
  evaluatorId    String
  evaluator      FacultyProfile @relation(fields: [evaluatorId], references: [id])
  isPrimary      Boolean  @default(true) // distinguishes Double Evaluation assigned faculty
  status         String   @default("ASSIGNED") // ASSIGNED, COMPLETED, REASSIGNED
  createdAt      DateTime @default(now())
}

model EvaluationRecord {
  id             String   @id @default(uuid())
  scriptId       String
  script         AnswerScript @relation(fields: [scriptId], references: [id])
  evaluatorId    String
  evaluator      FacultyProfile @relation(fields: [evaluatorId], references: [id])
  marksAwarded   Float
  feedback       String?
  evaluatedAt    DateTime @default(now())

  @@unique([scriptId, evaluatorId]) // Single evaluation per faculty per script
}

model ModerationRecord {
  id             String   @id @default(uuid())
  scriptId       String
  script         AnswerScript @relation(fields: [scriptId], references: [id])
  moderatorId    String
  moderator      FacultyProfile @relation(fields: [moderatorId], references: [id])
  originalMarks  Float
  moderatedMarks Float
  reason         String
  moderatedAt    DateTime @default(now())
}

model ResultPublication {
  id             String   @id @default(uuid())
  examScheduleId String
  examSchedule   ExamSchedule @relation(fields: [examScheduleId], references: [id])
  publishedBy    String   // UserId of the admin/HOD triggering publication
  status         PublicationStatus @default(DRAFT)
  publishedAt    DateTime?
  version        Int      @default(1)
}

enum PublicationStatus {
  DRAFT
  VERIFIED
  APPROVED
  RELEASED
}

model RevaluationRequest {
  id             String   @id @default(uuid())
  scriptId       String
  script         AnswerScript @relation(fields: [scriptId], references: [id])
  invoiceId      String?  // Integration with Finance
  status         RevaluationStatus @default(PENDING_PAYMENT)
  originalMarks  Float
  newMarks       Float?
  requestedAt    DateTime @default(now())
  resolvedAt     DateTime?
}

enum RevaluationStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFIED
  IN_PROCESS
  NO_CHANGE
  MARKS_ALTERED
}
