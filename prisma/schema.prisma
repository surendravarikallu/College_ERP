generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnswerScript {
  id                 String               @id
  examScheduleId     String
  studentId          String
  maskedId           String               @unique
  status             ScriptStatus         @default(PENDING)
  finalMarks         Float?
  ExamSchedule       ExamSchedule         @relation(fields: [examScheduleId], references: [id])
  StudentProfile     StudentProfile       @relation(fields: [studentId], references: [id])
  EvaluationRecord   EvaluationRecord[]
  ModerationRecord   ModerationRecord[]
  RevaluationRequest RevaluationRequest[]
  ScriptAllocation   ScriptAllocation[]

  @@unique([examScheduleId, studentId])
}

model AttendanceRecord {
  id                String            @id
  sessionId         String
  studentId         String
  isPresent         Boolean
  AttendanceSession AttendanceSession @relation(fields: [sessionId], references: [id])
  StudentProfile    StudentProfile    @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

model AttendanceSession {
  id               String             @id
  timeSlotId       String
  sessionDate      DateTime
  status           AttStatus          @default(ACTIVE)
  AttendanceRecord AttendanceRecord[]
  TimeSlot         TimeSlot           @relation(fields: [timeSlotId], references: [id])

  @@unique([timeSlotId, sessionDate])
}

model AuditLog {
  id            String   @id
  institutionId String
  userId        String?
  action        String
  resourceTable String
  resourceId    String
  oldValues     Json?
  newValues     Json?
  correlationId String?
  createdAt     DateTime @default(now())
  User          User?    @relation(fields: [userId], references: [id])

  @@index([institutionId, resourceTable, resourceId])
}

model Batch {
  id             String           @id
  courseId       String
  year           Int
  Course         Course           @relation(fields: [courseId], references: [id])
  StudentProfile StudentProfile[]
  TimeSlot       TimeSlot[]
}

model BedAllocation {
  id             String         @id
  roomId         String
  studentId      String
  allocatedFrom  DateTime
  allocatedTo    DateTime?
  status         String         @default("ACTIVE")
  HostelRoom     HostelRoom     @relation(fields: [roomId], references: [id])
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
}

model Course {
  id           String     @id
  departmentId String
  name         String
  Batch        Batch[]
  Department   Department @relation(fields: [departmentId], references: [id])
  Subject      Subject[]
}

model Department {
  id             String           @id
  institutionId  String
  name           String
  code           String           @unique @default("CSE")
  Course         Course[]
  Institution    Institution      @relation(fields: [institutionId], references: [id])
  FacultyProfile FacultyProfile[]
  students       Student[]        @relation("DeptStudents")
  facultyNew     Faculty[]        @relation("DeptFaculty")
  subjects       NewSubject[]     @relation("DeptSubjects")
}

model DriverAllocation {
  id        String  @id
  vehicleId String
  routeId   String
  Route     Route   @relation(fields: [routeId], references: [id])
  Vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
}

model EvaluationRecord {
  id             String         @id
  scriptId       String
  evaluatorId    String
  marksAwarded   Float
  feedback       String?
  evaluatedAt    DateTime       @default(now())
  FacultyProfile FacultyProfile @relation(fields: [evaluatorId], references: [id])
  AnswerScript   AnswerScript   @relation(fields: [scriptId], references: [id])

  @@unique([scriptId, evaluatorId])
}

model ExamSchedule {
  id                String              @id
  subjectId         String
  examDate          DateTime
  maxMarks          Float
  workflowStatus    WorkflowStatus      @default(DRAFT)
  AnswerScript      AnswerScript[]
  Subject           Subject             @relation(fields: [subjectId], references: [id])
  MarksInternal     MarksInternal[]
  ResultPublication ResultPublication[]
  GradeRecord       GradeRecord[]
  HallTicket        HallTicket[]
}

model FacultyProfile {
  id                 String               @id
  userId             String               @unique
  institutionId      String
  firstName          String
  lastName           String
  departmentId       String?
  EvaluationRecord   EvaluationRecord[]
  Department         Department?          @relation(fields: [departmentId], references: [id])
  User               User                 @relation(fields: [userId], references: [id])
  ModerationRecord   ModerationRecord[]
  ScriptAllocation   ScriptAllocation[]
  TeachingAllocation TeachingAllocation[]
}

model FeeStructure {
  id              String            @id
  institutionId   String
  name            String
  amount          Float
  Institution     Institution       @relation(fields: [institutionId], references: [id])
  InvoiceLineItem InvoiceLineItem[]
}

model GradingScale {
  id       String @id
  minMarks Float
  maxMarks Float
  grade    String
}

model HostelHistoryLog {
  id             String         @id
  studentId      String
  roomId         String
  action         String
  date           DateTime
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
}

model HostelRoom {
  id            String          @id
  roomNo        String
  capacity      Int
  BedAllocation BedAllocation[]
}

model Institution {
  id           String         @id
  name         String
  createdAt    DateTime       @default(now())
  Department   Department[]
  FeeStructure FeeStructure[]
  Settings     Settings[]
  User         User[]
}

model InventoryAllocation {
  id             String         @id
  assetId        String
  allocatedTo    String
  dateIssued     DateTime
  dateReturned   DateTime?
  InventoryAsset InventoryAsset @relation(fields: [assetId], references: [id])
}

model InventoryAsset {
  id                  String                @id
  name                String
  status              String                @default("AVAILABLE")
  InventoryAllocation InventoryAllocation[]
}

model Invoice {
  id              String            @id
  studentId       String
  totalAmount     Float
  status          InvoiceStatus     @default(DUE)
  idempotencyKey  String            @unique
  dueDate         DateTime
  StudentProfile  StudentProfile    @relation(fields: [studentId], references: [id])
  InvoiceLineItem InvoiceLineItem[]
  Payment         Payment[]
}

model InvoiceLineItem {
  id             String       @id
  invoiceId      String
  feeStructureId String
  amount         Float
  FeeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  Invoice        Invoice      @relation(fields: [invoiceId], references: [id])
}

model JobArchive {
  id         String    @id
  jobName    String
  payload    Json
  status     JobStatus @default(PENDING)
  errorLog   String?
  retryCount Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([status, jobName])
}

model LibraryCopy {
  id                 String               @id
  bookId             String
  status             String               @default("AVAILABLE")
  LibraryTransaction LibraryTransaction[]
}

model LibraryTransaction {
  id          String      @id
  copyId      String
  userId      String
  issueDate   DateTime
  dueDate     DateTime
  returnDate  DateTime?
  fineAmount  Float       @default(0)
  LibraryCopy LibraryCopy @relation(fields: [copyId], references: [id])
}

model MarksInternal {
  id              String       @id
  examScheduleId  String
  studentId       String
  marksObtained   Float
  gradeCalculated String?
  isLocked        Boolean      @default(false)
  version         Int          @default(1)
  ExamSchedule    ExamSchedule @relation(fields: [examScheduleId], references: [id])

  @@unique([examScheduleId, studentId])
}

model ModerationRecord {
  id             String         @id
  scriptId       String
  moderatorId    String
  originalMarks  Float
  moderatedMarks Float
  reason         String
  moderatedAt    DateTime       @default(now())
  FacultyProfile FacultyProfile @relation(fields: [moderatorId], references: [id])
  AnswerScript   AnswerScript   @relation(fields: [scriptId], references: [id])
}

model Payment {
  id             String        @id
  invoiceId      String
  amountPaid     Float
  method         String
  transactionRef String        @unique
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  Invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  Refund         Refund[]
}

model Refund {
  id        String       @id
  paymentId String
  amount    Float
  reason    String
  status    RefundStatus @default(INITIATED)
  Payment   Payment      @relation(fields: [paymentId], references: [id])
}

model ReportsDailyAttendanceAgg {
  id            String   @id
  institutionId String
  departmentId  String?
  date          DateTime
  present       Int
  absent        Int

  @@unique([institutionId, departmentId, date])
}

model ReportsMonthlyFinanceAgg {
  id             String @id
  institutionId  String
  year           Int
  month          Int
  totalCollected Float
  due            Float

  @@unique([institutionId, year, month])
}

model ResultPublication {
  id             String            @id
  examScheduleId String
  publishedBy    String
  status         PublicationStatus @default(DRAFT)
  publishedAt    DateTime?
  version        Int               @default(1)
  ExamSchedule   ExamSchedule      @relation(fields: [examScheduleId], references: [id])
}

model RevaluationRequest {
  id            String            @id
  scriptId      String
  invoiceId     String?
  status        RevaluationStatus @default(PENDING_PAYMENT)
  originalMarks Float
  newMarks      Float?
  requestedAt   DateTime          @default(now())
  resolvedAt    DateTime?
  AnswerScript  AnswerScript      @relation(fields: [scriptId], references: [id])
}

model Route {
  id               String             @id
  name             String
  DriverAllocation DriverAllocation[]
  RouteStop        RouteStop[]
}

model RouteStop {
  id                   String                 @id
  routeId              String
  name                 String
  Route                Route                  @relation(fields: [routeId], references: [id])
  StudentTransportPass StudentTransportPass[]
}

model ScriptAllocation {
  id             String         @id
  scriptId       String
  evaluatorId    String
  isPrimary      Boolean        @default(true)
  status         String         @default("ASSIGNED")
  createdAt      DateTime       @default(now())
  FacultyProfile FacultyProfile @relation(fields: [evaluatorId], references: [id])
  AnswerScript   AnswerScript   @relation(fields: [scriptId], references: [id])
}

model Settings {
  id            String      @id
  institutionId String
  key           String
  value         String
  Institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, key])
}

model StudentProfile {
  id                   String                 @id
  userId               String                 @unique
  institutionId        String
  firstName            String
  lastName             String
  enrollmentNo         String                 @unique
  batchId              String?
  AnswerScript         AnswerScript[]
  AttendanceRecord     AttendanceRecord[]
  BedAllocation        BedAllocation[]
  HostelHistoryLog     HostelHistoryLog[]
  Invoice              Invoice[]
  Batch                Batch?                 @relation(fields: [batchId], references: [id])
  User                 User                   @relation(fields: [userId], references: [id])
  StudentTransportPass StudentTransportPass[]
  Scholarship          Scholarship?
  GradeRecord          GradeRecord[]
  HallTicket           HallTicket[]

  @@index([institutionId, batchId])
}

model StudentTransportPass {
  id             String         @id
  studentId      String
  routeStopId    String
  RouteStop      RouteStop      @relation(fields: [routeStopId], references: [id])
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
}

model Subject {
  id                 String               @id
  courseId           String
  name               String
  code               String               @unique
  ExamSchedule       ExamSchedule[]
  Course             Course               @relation(fields: [courseId], references: [id])
  TeachingAllocation TeachingAllocation[]
}

model TeachingAllocation {
  id             String         @id
  subjectId      String
  facultyId      String
  FacultyProfile FacultyProfile @relation(fields: [facultyId], references: [id])
  Subject        Subject        @relation(fields: [subjectId], references: [id])
  TimeSlot       TimeSlot[]

  @@unique([subjectId, facultyId])
}

model TimeSlot {
  id                   String              @id
  batchId              String
  teachingAllocationId String
  dayOfWeek            Int
  startTime            String
  endTime              String
  AttendanceSession    AttendanceSession[]
  Batch                Batch               @relation(fields: [batchId], references: [id])
  TeachingAllocation   TeachingAllocation  @relation(fields: [teachingAllocationId], references: [id])

  @@index([dayOfWeek, startTime, endTime])
}

model User {
  id               String          @id
  institutionId    String
  email            String          @unique
  passwordHash     String
  role             Role            @default(STUDENT)
  isActive         Boolean         @default(true)
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  lastLogin        DateTime?
  createdAt        DateTime        @default(now())
  AuditLog         AuditLog[]
  FacultyProfile   FacultyProfile?
  StudentProfile   StudentProfile?
  Institution      Institution     @relation(fields: [institutionId], references: [id])
  Notification     Notification[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  student          Student?
  faculty          Faculty?

  @@index([institutionId, role])
}

model Vehicle {
  id               String             @id
  registrationNo   String
  capacity         Int
  DriverAllocation DriverAllocation[]
}

model audit_logs {
  id           Int       @id @default(autoincrement())
  action_type  String
  entity_type  String
  entity_id    Int
  performed_by Int
  reason       String?
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  ec_admins    ec_admins @relation(fields: [performed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audit_logs_performed_by_admins_id_fk")
}

model ec_admins {
  id                        Int            @id(map: "admins_pkey") @default(autoincrement())
  username                  String         @unique(map: "admins_username_unique")
  password                  String
  is_admin                  Boolean        @default(false)
  can_upload                Boolean        @default(false)
  can_manage_settings       Boolean        @default(false)
  can_manage_academics      Boolean        @default(false)
  can_manage_internal_marks Boolean        @default(false)
  can_view_dashboard        Boolean        @default(false)
  can_view_students         Boolean        @default(false)
  can_view_reports          Boolean        @default(false)
  can_freeze_marks          Boolean        @default(false)
  login_type                String         @default("GLOBAL")
  allowed_ips               String         @default("")
  audit_logs                audit_logs[]
  ec_mid_marks              ec_mid_marks[]
}

model ec_audit_logs {
  id           Int      @id @default(autoincrement())
  action_type  String
  entity_type  String
  entity_id    Int
  performed_by Int
  reason       String?
  created_at   DateTime @default(now()) @db.Timestamp(6)
}

model ec_faculty {
  id                     Int                      @id @default(autoincrement())
  faculty_name           String
  department             String?
  designation            String?
  ec_faculty_subject_map ec_faculty_subject_map[]
}

model ec_faculty_subject_map {
  id            Int        @id @default(autoincrement())
  faculty_id    Int
  subject_code  String
  semester      String
  branch        String
  batch         String
  academic_year String
  section       String?
  ec_faculty    ec_faculty @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ec_global_settings {
  id                Int      @id(map: "global_settings_pkey") @default(autoincrement())
  auto_lock_on_save Boolean  @default(true)
  updated_at        DateTime @default(now()) @db.Timestamp(6)
}

model ec_mid_exams {
  id              Int       @id @default(autoincrement())
  academic_year   String
  semester        String
  branch          String
  batch           String    @default("")
  subject_code    String
  mid_type        String
  max_marks       Int       @default(30)
  is_frozen       Boolean   @default(false)
  is_final_locked Boolean   @default(false)
  locked_at       DateTime? @db.Timestamp(6)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
}

model ec_mid_marks {
  id                   Int         @id(map: "mid_marks_pkey") @default(autoincrement())
  student_id           Int
  mid_exam_id          Int
  mid_exam_marks       Float       @default(0)
  assignment_marks     Float       @default(0)
  quiz_marks           Float       @default(0)
  total_marks          Float       @default(0)
  entered_by           Int
  updated_at           DateTime    @default(now()) @db.Timestamp(6)
  created_at           DateTime    @default(now()) @db.Timestamp(6)
  lab_daily_marks      Float       @default(0)
  lab_record_marks     Float       @default(0)
  lab_internal_marks   Float       @default(0)
  lab_viva_marks       Float       @default(0)
  prc_assessment_marks Float       @default(0)
  report_marks         Float       @default(0)
  seminar_marks        Float       @default(0)
  is_locked            Boolean     @default(false)
  locked_at            DateTime?   @db.Timestamp(6)
  ec_admins            ec_admins   @relation(fields: [entered_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mid_marks_entered_by_admins_id_fk")
  mid_exams            mid_exams   @relation(fields: [mid_exam_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mid_marks_mid_exam_id_mid_exams_id_fk")
  ec_students          ec_students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mid_marks_student_id_students_id_fk")

  @@unique([student_id, mid_exam_id], map: "unique_mid_mark_idx")
}

model ec_results {
  id             Int         @id(map: "results_pkey") @default(autoincrement())
  student_id     Int
  subject_id     Int
  semester       String
  academic_year  String
  exam_type      String
  attempt_no     Int
  grade          String
  grade_points   Int
  credits_earned Float
  status         String
  is_latest      Boolean     @default(true)
  created_at     DateTime?   @default(now()) @db.Timestamp(6)
  internal_marks Int?
  ec_students    ec_students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "results_student_id_students_id_fk")

  @@unique([student_id, subject_id, exam_type, academic_year], map: "unique_result_idx")
}

model ec_student_academic_status {
  id            Int      @id @default(autoincrement())
  student_id    Int
  academic_year String
  semester      String
  status        String
  reason        String?  @default("")
  updated_at    DateTime @default(now()) @db.Timestamp(6)
}

model ec_student_photos {
  id         Int    @id @default(autoincrement())
  student_id Int    @unique
  photo_data String
}

model ec_students {
  id                      Int                       @id(map: "students_pkey") @default(autoincrement())
  roll_number             String                    @unique(map: "students_roll_number_unique")
  name                    String
  branch                  String
  batch                   String
  regulation              String
  program                 String?
  section                 String?
  gender                  String?
  phone                   String?
  address                 String?
  father_name             String?
  ec_mid_marks            ec_mid_marks[]
  ec_results              ec_results[]
  student_academic_status student_academic_status[]
  student_photos          student_photos?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ec_subjects {
  id           Int    @default(autoincrement())
  subject_code String
  subject_name String
  credits      Float
  semester     String
  branch       String

  @@ignore
}

model faculty {
  id                  Int                   @id @default(autoincrement())
  faculty_name        String
  department          String?
  designation         String?
  faculty_subject_map faculty_subject_map[]
}

model faculty_subject_map {
  id            Int     @id @default(autoincrement())
  faculty_id    Int
  subject_code  String
  semester      String
  branch        String
  academic_year String
  section       String?
  batch         String
  faculty       faculty @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "faculty_subject_map_faculty_id_faculty_id_fk")
}

model mid_exams {
  id              Int            @id @default(autoincrement())
  academic_year   String
  semester        String
  branch          String
  subject_code    String
  mid_type        String
  max_marks       Int            @default(30)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  batch           String         @default("")
  is_frozen       Boolean        @default(false)
  is_final_locked Boolean        @default(false)
  locked_at       DateTime?      @db.Timestamp(6)
  ec_mid_marks    ec_mid_marks[]
}

model student_academic_status {
  id            Int         @id @default(autoincrement())
  student_id    Int
  academic_year String
  semester      String
  status        String
  reason        String?     @default("")
  updated_at    DateTime    @default(now()) @db.Timestamp(6)
  ec_students   ec_students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "student_academic_status_student_id_students_id_fk")
}

model student_photos {
  id          Int         @id @default(autoincrement())
  student_id  Int         @unique(map: "student_photos_student_id_unique")
  photo_data  String
  ec_students ec_students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "student_photos_student_id_students_id_fk")
}

model subjects {
  id           Int    @id @default(autoincrement())
  subject_code String @unique(map: "subjects_subject_code_unique")
  subject_name String
  credits      Float
  semester     String
  branch       String
}

enum AttStatus {
  ACTIVE
  LOCKED
}

enum InvoiceStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  SUCCESS
  FAILED
  REFUNDED
}

enum PublicationStatus {
  DRAFT
  VERIFIED
  APPROVED
  RELEASED
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}

enum RevaluationStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFIED
  IN_PROCESS
  NO_CHANGE
  MARKS_ALTERED
}

enum Role {
  SUPERADMIN
  SUPER_ADMIN
  ADMIN
  PRINCIPAL
  HOD
  FACULTY
  STUDENT
  STAFF
  EXAM_CELL
  ACCOUNTS
  HOSTEL_WARDEN
  LIBRARIAN
}

enum ScriptStatus {
  PENDING
  ALLOCATED
  EVALUATED
  REVIEWED
  FINALIZED
}

enum WorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

model Scholarship {
  id             String         @id @default(uuid())
  studentId      String         @unique
  isActive       Boolean        @default(true)
  percentage     Float?
  amount         Float?
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
}

model GradeRecord {
  id             String         @id @default(uuid())
  studentId      String
  examScheduleId String?
  sgpa           Float
  totalCredits   Int
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
  ExamSchedule   ExamSchedule?  @relation(fields: [examScheduleId], references: [id])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  title     String
  message   String
  body      String            @default("")
  type      String            @default("INFO")
  isRead    Boolean           @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime          @default(now())
  User      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model HallTicket {
  id             String         @id @default(uuid())
  studentId      String
  examScheduleId String
  url            String?
  issuedAt       DateTime       @default(now())
  status         String         @default("ISSUED")
  StudentProfile StudentProfile @relation(fields: [studentId], references: [id])
  ExamSchedule   ExamSchedule   @relation(fields: [examScheduleId], references: [id])

  @@unique([studentId, examScheduleId])
}

// ═══════════════════════════════════════════════════════
// NEW MODELS — Added by Sub-Prompt 01-03 Fixes
// ═══════════════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  OD
  MEDICAL_LEAVE
}

enum NotificationType {
  ATTENDANCE_ALERT
  EXAM_RESULT
  FEE_REMINDER
  GENERAL
  MARKS_PUBLISHED
  HALL_TICKET
}

enum LeaveStatus {
  LEAVE_PENDING
  LEAVE_APPROVED
  LEAVE_REJECTED
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model Student {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  name         String
  rollNumber   String    @unique
  departmentId String
  department   Department @relation("DeptStudents", fields: [departmentId], references: [id])
  batchId      String?
  semester     Int       @default(1)
  gender       Gender?
  phone        String?
  address      String?
  guardianName String?
  guardianPhone String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attendances     NewAttendance[]
  marks           NewMark[]
  gradeRecordsNew NewGradeRecord[]
  hallTicketsNew  NewHallTicket[]
  feeInvoices     FeeInvoice[]
  hostelAllocation HostelAllocation[]
  libraryCard     LibraryCard?
  scholarshipNew  ScholarshipNew?

  @@index([departmentId])
  @@index([batchId])
}

model Faculty {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  name         String
  employeeId   String    @unique
  departmentId String
  department   Department @relation("DeptFaculty", fields: [departmentId], references: [id])
  designation  String?
  phone        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subjectMappings FacultySubjectMapping[]
  attendances     NewAttendance[]

  @@index([departmentId])
}

model NewSubject {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  departmentId String
  department   Department @relation("DeptSubjects", fields: [departmentId], references: [id])
  semester     Int
  credits      Int       @default(3)
  isLab        Boolean   @default(false)
  isSpecial    Boolean   @default(false)
  specialType  String?
  regulation   String    @default("R20")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  marks           NewMark[]
  attendances     NewAttendance[]
  facultyMappings FacultySubjectMapping[]

  @@index([departmentId, semester])
}

model FacultySubjectMapping {
  id           String   @id @default(cuid())
  facultyId    String
  faculty      Faculty  @relation(fields: [facultyId], references: [id])
  subjectId    String
  subject      NewSubject @relation(fields: [subjectId], references: [id])
  batchId      String?
  semester     Int
  academicYear String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([facultyId, subjectId, semester, academicYear])
  @@index([facultyId])
  @@index([subjectId])
}

model NewAttendance {
  id            String           @id @default(cuid())
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       NewSubject       @relation(fields: [subjectId], references: [id])
  facultyId     String
  faculty       Faculty          @relation(fields: [facultyId], references: [id])
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  hour          Int              @default(1)
  remark        String?
  correctedAt   DateTime?
  correctedById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([studentId, subjectId, date, hour])
  @@index([studentId, date])
  @@index([subjectId, date])
  @@index([facultyId, date])
  @@index([studentId, subjectId])
}

model ExamSession {
  id           String    @id @default(cuid())
  name         String
  examType     String
  semester     Int
  academicYear String
  startDate    DateTime
  endDate      DateTime
  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedById   String?
  createdAt    DateTime  @default(now())

  marks       NewMark[]
  hallTickets NewHallTicket[]

  @@index([semester, academicYear])
}

model NewMark {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       NewSubject  @relation(fields: [subjectId], references: [id])
  examSessionId String
  examSession   ExamSession @relation(fields: [examSessionId], references: [id])
  marksObtained Float?
  maxMarks      Float       @default(30)
  isAbsent      Boolean     @default(false)
  isDetained    Boolean     @default(false)
  enteredById   String?
  verifiedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([studentId, subjectId, examSessionId])
  @@index([studentId, subjectId])
  @@index([examSessionId])
  @@index([subjectId, examSessionId])
}

model NewGradeRecord {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  semester      Int
  academicYear  String
  sgpa          Float
  cgpa          Float     @default(0)
  totalCredits  Int
  earnedCredits Int       @default(0)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, semester, academicYear])
  @@index([studentId])
}

model NewHallTicket {
  id               String      @id @default(cuid())
  studentId        String
  student          Student     @relation(fields: [studentId], references: [id])
  examSessionId    String
  examSession      ExamSession @relation(fields: [examSessionId], references: [id])
  eligibleSubjects Json
  isEligible       Boolean     @default(true)
  ineligibleReason String?
  generatedAt      DateTime    @default(now())
  pdfPath          String?

  @@unique([studentId, examSessionId])
  @@index([studentId])
  @@index([examSessionId])
}

model FeeStructureNew {
  id           String       @id @default(cuid())
  name         String
  feeType      String
  amount       Float
  departmentId String?
  semester     Int?
  academicYear String
  dueDate      DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  invoices     FeeInvoice[]
}

model FeeInvoice {
  id              String           @id @default(cuid())
  invoiceNumber   String           @unique
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  feeStructureId  String
  feeStructure    FeeStructureNew  @relation(fields: [feeStructureId], references: [id])
  amount          Float
  discount        Float            @default(0)
  finalAmount     Float
  status          PaymentStatus    @default(PENDING)
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions    PaymentTransaction[]

  @@index([studentId])
  @@index([status])
}

model PaymentTransaction {
  id                  String        @id @default(cuid())
  invoiceId           String
  invoice             FeeInvoice    @relation(fields: [invoiceId], references: [id])
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  amount              Float
  status              PaymentStatus @default(PENDING)
  webhookVerified     Boolean       @default(false)
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([invoiceId])
  @@index([razorpayOrderId])
}

model ScholarshipNew {
  id         String  @id @default(cuid())
  studentId  String  @unique
  student    Student @relation(fields: [studentId], references: [id])
  isActive   Boolean @default(true)
  percentage Float?
  amount     Float?
}

model HostelBlock {
  id        String       @id @default(cuid())
  name      String
  gender    Gender
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  rooms     HostelRoomNew[]
}

model HostelRoomNew {
  id         String             @id @default(cuid())
  blockId    String
  block      HostelBlock        @relation(fields: [blockId], references: [id])
  roomNumber String
  capacity   Int                @default(2)
  occupancy  Int                @default(0)
  monthlyFee Float              @default(0)
  isActive   Boolean            @default(true)
  allocations HostelAllocation[]
}

model HostelAllocation {
  id        String       @id @default(cuid())
  studentId String
  student   Student      @relation(fields: [studentId], references: [id])
  roomId    String
  room      HostelRoomNew @relation(fields: [roomId], references: [id])
  fromDate  DateTime
  toDate    DateTime?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model LibraryBook {
  id              String     @id @default(cuid())
  title           String
  author          String
  isbn            String     @unique
  publisher       String?
  edition         String?
  subject         String?
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  issues          BookIssue[]
}

model LibraryCard {
  id        String     @id @default(cuid())
  studentId String     @unique
  student   Student    @relation(fields: [studentId], references: [id])
  cardNumber String    @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  issues    BookIssue[]
}

model BookIssue {
  id         String      @id @default(cuid())
  bookId     String
  book       LibraryBook @relation(fields: [bookId], references: [id])
  cardId     String
  card       LibraryCard @relation(fields: [cardId], references: [id])
  issueDate  DateTime    @default(now())
  dueDate    DateTime
  returnDate DateTime?
  isReturned Boolean     @default(false)
  fine       Float       @default(0)
  createdAt  DateTime    @default(now())

  @@index([cardId])
  @@index([bookId])
}
